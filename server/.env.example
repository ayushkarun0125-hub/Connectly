PORT=3001
CLIENT_URL=http://localhost:5173
# Comma-separated extra browser origins (e.g. http://192.168.1.5:5173) if you use production CORS mode.
# CORS_ORIGINS=
# Set LAN_DEV=1 with NODE_ENV=production to allow private LAN origins (not recommended for public servers).
# LAN_DEV=
DB_PATH=./data/connectly.sqlite

# Default admin (seeded on startup when not in production, or when SEED_ADMIN=1).
# SEED_ADMIN=0        # set to disable seeding entirely
# SEED_ADMIN=1        # required to seed when NODE_ENV=production (use with care)
# ADMIN_EMAIL=admin@connectly.local
# ADMIN_PASSWORD=ConnectlyAdmin2026!
JWT_SECRET=dev_jwt_secret_change_me
